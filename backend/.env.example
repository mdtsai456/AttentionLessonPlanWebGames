DB_HOST=43.163.233.40
DB_PORT=31913
DB_USER=app_ro
DB_PASSWORD=your_read_password_here
DB_WRITE_USER=game_writer
DB_WRITE_PASSWORD=your_write_password_here
DB_NAME=AttentionLessonPlan

API_HOST=127.0.0.1
API_PORT=5001

TEST_DB_NAME=AttentionLessonPlan_test

# 前端跨網域請求時，須允許其 origin。多個值以逗號分隔。開發時可用單一 * 允許全部。
# 留空時，只允許常用的本機開發伺服器 localhost:3000/5173/5500/8080。
# 部署至 Zeabur 時，將本檔變數填入後端服務的 Environment。不要提交 .env。
# CORS_ALLOW_ORIGINS 使用前端的 HTTPS 網址。成績儲存在 MariaDB，API 服務無須掛載 Volume。
# 例：CORS_ALLOW_ORIGINS=https://your-frontend.zeabur.app
CORS_ALLOW_ORIGINS=

# GET /api/attention/me 將手錶專心判定請求轉發至此平台。留空時使用 https://xsensdotdata2server.zeabur.app。
WATCH_API_BASE=
# 設為 1 時，不呼叫手錶平台，固定回傳 result=1，以測試煙火畫面。正式環境須留空。
WATCH_PREDICT_MOCK=
